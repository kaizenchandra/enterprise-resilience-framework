{
  "title": "Resilience",
  "uid": "resilience",
  "schemaVersion": 40,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "State",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "resilience_circuit_state",
          "legendFormat": "{{policy}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Failures",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(resilience_failure_total[1m])",
          "legendFormat": "{{policy}}"
        }
      ]
    },
