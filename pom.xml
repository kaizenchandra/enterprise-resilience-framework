<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>
    <groupId>dev.resilience</groupId>
    <artifactId>enterprise-resilience-framework</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>
    <modules>
        <module>resilience-core</module>
        <module>resilience-circuitbreaker</module>
        <module>resilience-retry</module>
        <module>resilience-bulkhead</module>
        <module>resilience-timelimiter</module>
        <module>resilience-executor</module>
        <module>resilience-redis</module>
        <module>resilience-micrometer</module>
        <module>resilience-spring-boot-starter</module>
        <module>resilience-benchmarks</module>
        <module>integration-tests</module>
        <module>examples/order-service</module>
        <module>examples/payment-service-simulator</module>
        <module>examples/demo-client</module>
    </modules>
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
