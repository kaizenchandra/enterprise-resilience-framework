{
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "metrics-server",
            "env": [
              {
                "name": "GOMEMLIMIT",
                "value": "256MiB"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "200m",
                "memory": "256Mi"
              },
              "limits": {
                "cpu": "1",
                "memory": "512Mi"
              }
            },
            "readinessProbe": {
              "timeoutSeconds": 5
            },
            "livenessProbe": {
              "timeoutSeconds": 5
            },
            "startupProbe": {
              "httpGet": {
                "path": "/livez",
                "port": "https",
                "scheme": "HTTPS"
              },
              "periodSeconds": 2,
              "timeoutSeconds": 5,
              "failureThreshold": 60
            }
          }
        ]
      }
    }
  }
}
